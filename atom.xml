---
layout: null
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:base="{{ site.url }}/">

 <title>{{ site.title | xml_escape }}: News and Blog</title>
 <link href="{{ site.url }}/atom.xml" rel="self"/>
 <link href="{{ site.url }}/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>{{ site.url }}/</id>
 <author>
   <name>{{ site.author.name | xml_escape }}</name>
   <email>{{ site.author.email | xml_escape }}</email>
 </author>

 {% assign feed_posts = site.categories.news | concat: site.categories.blog | sort: "date" | reverse %}
 {% for post in feed_posts %}
 <entry>
   <title>{{ post.title | xml_escape }}</title>
   <link href="{{ site.url }}{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>tag:www.frohlichlab.com,{{ post.date | date: "%Y-%m-%d" }}:{{ post.url }}</id>
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}

</feed>
